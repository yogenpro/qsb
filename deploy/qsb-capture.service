[Unit]
Description=Cboe QSB and CPM raw order-book archive
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/qsb
ExecStart=/usr/bin/python3.12 -m qsb_capture.runtime run --output %h/qsb/captures/production --config %h/qsb/config/local.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
