{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsb-dashboard",
  "compatibility_date": "2026-10-31",
  "main": "worker.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*"],
    "not_found_handling": "none"
  },
  "env": {
    "dev": {
      "name": "qsb-dashboard-dev",
      "workers_dev": false,
      "preview_urls": false
    },
    "prod": {
      "name": "qsb-dashboard-prod",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
